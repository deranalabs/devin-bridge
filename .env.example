# Required: key clients must send to the bridge.
# Generate: python3 -c "import secrets; print('db-' + secrets.token_hex(16))"
BRIDGE_API_KEY=
BRIDGE_PORT=8320

# CLI backend (devin-cli/<model>)
DEVIN_CLI_BIN=devin
DEVIN_CLI_WORKDIR=~/.devin-bridge/workspace
# DEVIN_CLI_RESPECT_TRUST=true

# Cloud backend (devin, devin-fast, ...); leave empty to use the CLI only
DEVIN_API_KEY=
DEVIN_ORG_ID=
# DEVIN_WARM=0
# DEVIN_MAX_ACU=5
