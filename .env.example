# Wajib: key yang harus dikirim klien ke bridge. Buat acak, mis: python3 -c "import secrets;print('db-'+secrets.token_hex(16))"
BRIDGE_API_KEY=
BRIDGE_PORT=8320

# Jalur CLI (devin-cli/<model>)
DEVIN_CLI_BIN=devin
DEVIN_CLI_WORKDIR=~/.devin-bridge/workspace

# Jalur cloud (model "devin*"); kosongkan kalau hanya pakai CLI
DEVIN_API_KEY=
DEVIN_ORG_ID=
# DEVIN_WARM=0
# DEVIN_MAX_ACU=5
